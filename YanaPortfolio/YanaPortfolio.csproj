<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WebRoot>wwwroot-built</WebRoot>
  </PropertyGroup>
  <Target Name="BuildPortfolioFrontend" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="pnpm run build" />
    <ItemGroup>
      <Content Include="wwwroot-built/**/*" Exclude="@(Content)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Content Include="wwwroot-built/**/*" Exclude="@(Content)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
